# Copy to .env and fill in. NEVER commit .env (it is gitignored). Never paste
# the key into chat, screenshots or tickets.
# LLM API for semantic analysis. The endpoint must match api.provider in
# config/models.yaml:
#   provider: anthropic          -> https://01tree.ai/claudecode   (Claude; default)
#   provider: openai-compatible  -> https://01tree.ai/codex/v1     (GPT)
COMPASS_API_BASE_URL=https://01tree.ai/claudecode
COMPASS_API_KEY=sk-ant-oat01-REPLACE_WITH_YOUR_KEY
# Optional: session cookie for TU Delft SuccessFactors collector (S5+).
TUDELFT_COOKIE=
