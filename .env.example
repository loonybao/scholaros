# Copy to .env and fill in. NEVER commit .env (it is gitignored). Never paste
# the key into chat, screenshots or tickets.
# OpenAI-compatible API used for semantic analysis (S4+). For 01tree use the
# OpenAI-compatible (codex) endpoint; the model is set in config/models.yaml.
COMPASS_API_BASE_URL=https://01tree.ai/codex/v1
COMPASS_API_KEY=sk-ant-oat01-REPLACE_WITH_YOUR_KEY
# Optional: session cookie for TU Delft SuccessFactors collector (S5+).
TUDELFT_COOKIE=
